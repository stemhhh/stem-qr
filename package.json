{
  "name": "stem-qr",
  "private": true,
  "version": "1.0.0",
  "description": "STEM QR: generador de códigos QR personalizados para Windows.",
  "author": "Enmanuel",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "build:desktop": "npm run icons && npm run build && electron-builder --win nsis",
    "build:store": "npm run icons && npm run build && electron-builder --win appx",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "png-to-ico": "^3.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5"
  }
}
